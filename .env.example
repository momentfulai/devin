# Used by the Ask Northstar chat route (src/app/api/chat/route.ts) via the Vercel AI Gateway.
# TradingView widgets and lightweight-charts need no key.
VERCEL_AI_GATEWAY_API_KEY=

# Optional. Leave empty to use the AI SDK gateway default (https://ai-gateway.vercel.sh/v4/ai).
# https://ai-gateway.vercel.sh/v1 is the OpenAI-compatible endpoint and does not work with this provider.
VERCEL_AI_GATEWAY_BASE_URL=

# Any model the gateway exposes, e.g. openai/gpt-4o-mini, anthropic/claude-sonnet-4.5
CHAT_MODEL=openai/gpt-4o-mini
